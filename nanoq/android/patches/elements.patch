diff --git a/lib/artist/lib/CMakeLists.txt b/lib/artist/lib/CMakeLists.txt
index 95254bf..8cc2c6e 100644
--- a/lib/artist/lib/CMakeLists.txt
+++ b/lib/artist/lib/CMakeLists.txt
@@ -155,6 +155,47 @@ if (ARTIST_SKIA)
       set(CMAKE_CXX_FLAGS_DEBUG   "${CMAKE_CXX_FLAGS_DEBUG}   /MTd")
       set(CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} /Ob2 /Oi /Ot /GL /MT")
 
+   elseif (ANDROID)
+
+      # A vcpkg Skia for Android (arm64-android). No system harfbuzz or
+      # fontconfig to share with: Skia's own static harfbuzz and freetype, and
+      # fonts from files (font.cpp).
+      find_package(unofficial-skia CONFIG REQUIRED)
+
+      get_target_property(_skia_inc unofficial::skia::skia INTERFACE_INCLUDE_DIRECTORIES)
+      set(SKIA_INCLUDE_BASE "${_skia_inc}")
+      set(ARTIST_SKIA_EXTRA_INCLUDES
+         ${SKIA_INCLUDE_BASE}/core
+         ${SKIA_INCLUDE_BASE}/config
+         ${SKIA_INCLUDE_BASE}/codec
+         ${SKIA_INCLUDE_BASE}/effects
+         ${SKIA_INCLUDE_BASE}/gpu
+         ${SKIA_INCLUDE_BASE}/ports
+         ${SKIA_INCLUDE_BASE}/utils
+         ${SKIA_INCLUDE_BASE}/../harfbuzz
+      )
+
+      get_filename_component(_vcpkg_lib "${SKIA_INCLUDE_BASE}/../../lib" ABSOLUTE)
+      foreach (_lib harfbuzz freetype png16 z brotlidec brotlicommon bz2)
+         string(TOUPPER "ARTIST_ANDROID_${_lib}_LIB" _var)
+         find_library(${_var} ${_lib} PATHS "${_vcpkg_lib}"
+            NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
+         list(APPEND _artist_android_libs ${${_var}})
+      endforeach ()
+
+      # Static archives with cyclic dependencies (harfbuzz and freetype use
+      # each other; freetype needs png, zlib, brotli and bz2).
+      set(ARTIST_DEPEPENDENCIES
+         unofficial::skia::skia
+         -Wl,--start-group
+         ${_artist_android_libs}
+         -Wl,--end-group
+         EGL
+         GLESv3
+         android
+         log
+      )
+
    elseif (UNIX)
 
       find_package(unofficial-skia CONFIG REQUIRED)
