+      // The bitmap as the SkImage canvas::draw draws, made once, sharing
+      // the bitmap's pixels. asImage copied a mutable bitmap's pixels on
+      // every draw, and each new SkImage is a new texture to the GPU
+      // backends, uploaded (and its mipmaps made) each time; one kept image
+      // is uploaded once. Dropped when the pixels may have changed:
+      // image::pixels() and offscreen_image.
+      sk_sp<SkImage>    drawn;
+
+      void pixels_changed()
+      {
+         if (auto* bitmap = std::get_if<SkBitmap>(&base()))
+            bitmap->notifyPixelsChanged();
+         drawn.reset();
+      }
    };
 
