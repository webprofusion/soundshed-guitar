+void X11Gui::setSizeHints(int w, int h)
 {
-  if (!display || window == 0) return false;
-  XResizeWindow(display, window, w, h);
+  if (fullScreen) return;
 
   XSizeHints *hints = XAllocSizeHints();
-  hints->flags = PMinSize | PMaxSize;
-  hints->min_width = w;
-  hints->max_width = w;
-  hints->min_height = h;
-  hints->max_height = h;
+  auto ui = plugin ? plugin->_ext._gui : nullptr;
+
+  // Only a view that resizes can follow the window, and it can only say so once it exists.
+  if (viewShown && ui && ui->can_resize(plugin->_plugin))
+  {
+    hints->flags = 0;
+  }
+  else
+  {
+    hints->flags = PMinSize | PMaxSize;
+    hints->min_width = w;
+    hints->max_width = w;
+    hints->min_height = h;
+    hints->max_height = h;
+  }
 
   // Apply hints to the window
   XSetWMNormalHints(display, window, hints);
   XFree(hints);
+}
+
+void X11Gui::resizeView(int w, int h)
+{
+  auto ui = plugin ? plugin->_ext._gui : nullptr;
+  if (!viewShown || !ui || !ui->can_resize(plugin->_plugin)) return;
+
+  uint32_t current[2]{0, 0};
+  ui->get_size(plugin->_plugin, &current[0], &current[1]);
+  if (current[0] != uint32_t(w) || current[1] != uint32_t(h))
+  {
+    uint32_t width = w, height = h;
+    ui->adjust_size(plugin->_plugin, &width, &height);
+    ui->set_size(plugin->_plugin, width, height);
+  }
+}
+
+bool X11Gui::resetSizeTo(int w, int h)
+{
+  // A kiosk's window is the screen's size whatever the view would like.
+  if (!display || window == 0 || fullScreen) return false;
+  XResizeWindow(display, window, w, h);
+  setSizeHints(w, h);
 
   return true;
