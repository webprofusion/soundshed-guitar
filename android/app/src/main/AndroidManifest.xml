<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Outgoing HTTPS. The UI fetches from api.sepia.invalid (tone
      sharing), www.tone3000.com (model search) and www.googleapis.com
      (YouTube). Without this every request fails as "TypeError: Failed to
      fetch", which looks like a CORS or endpoint problem and is not.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Guitar input. Without this the amp has no signal to process. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- MIDI foot controllers, via JUCE's JuceMidiSupport. -->
    <uses-feature android:name="android.software.midi" android:required="false" />

    <uses-feature android:name="android.hardware.audio.low_latency" android:required="false" />
    <uses-feature android:name="android.hardware.audio.pro" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name="com.soundshed.guitar.SoundshedApp"
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:allowBackup="false"
       
        android:theme="@style/SoundshedTheme">

        <!-- Samsung's performance SDK (ClockFloor.java, experimental); absent elsewhere. -->
        <uses-native-library android:name="libperfsdk.performance.samsung.so" android:required="false" />

        <activity
            android:name="com.soundshed.guitar.MainActivity"
            android:exported="true"
            android:label="${appLabel}"
            android:launchMode="singleTask"
            android:screenOrientation="${screenOrientation}"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Matches the desktop builds' soundshed:// handoff scheme. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="soundshed" />
            </intent-filter>

            <!--
              Offers the app when a USB audio interface is plugged in, beside any
              other app that claims one. Audio flows through AAudio either way;
              this only puts us in the "Open with" choice.
            -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_audio_device_filter" />
        </activity>
    </application>
</manifest>
