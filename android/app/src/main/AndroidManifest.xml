<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Outgoing HTTPS. The UI fetches from api-guitar.soundshed.com (tone
      sharing), www.tone3000.com (model search) and www.googleapis.com
      (YouTube). Without this every request fails as "TypeError: Failed to
      fetch", which looks like a CORS or endpoint problem and is not.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Guitar input. Without this the amp has no signal to process. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- MIDI foot controllers, via JUCE's JuceMidiSupport. -->
    <uses-feature android:name="android.software.midi" android:required="false" />

    <uses-feature android:name="android.hardware.audio.low_latency" android:required="false" />
    <uses-feature android:name="android.hardware.audio.pro" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name="com.soundshed.guitar.SoundshedApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:allowBackup="false"
       
        android:theme="@style/SoundshedTheme">

        <activity
            android:name="com.soundshed.guitar.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Matches the desktop builds' soundshed:// handoff scheme. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="soundshed" />
            </intent-filter>
        </activity>
    </application>
</manifest>
