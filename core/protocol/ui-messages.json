  "engineOnlyRequests": {
    "getPerformanceStats": "A pull for tests and scripted debugging (MixerInstanceLockTests drives the telemetry read with it); the UI takes the pushed dspPerformance feed.",
    "getSignalDiagnostics": "A pull for tests and scripted debugging; the UI takes the pushed sld feed and asks for a roster with setSignalDiagnosticsEnabled.",
    "previewPreset": "Kept for a UI that has the preset in hand, and the preview's own tests (TonePreviewTests); both Tones panels now hand the engine the download itself (previewPresetArchive), which stages the files the same way.",
    "saveLibraryArchive": "Kept for older UIs and scripted use (saves library archive bytes a UI built itself); every UI now asks the engine to build and save the library archive with exportLibraryArchive.",
    "savePresetArchive": "Kept for older UIs and scripted use (saves archive bytes a UI built itself); every UI now asks the engine to build and save the archive with exportPresetArchive.",
    "setMasterGain": "Kept for older UIs and scripted use; the UI mutes with setOutputMuted, which the mixer applies after the output gain so a chain rebuild cannot undo it, and sets levels with setGlobalChainParam output.gain.",
    "setPresetFavorites": "Kept for older UIs and scripted use (a whole favourites document); every UI now stars presets one at a time (setPresetFavorite), and removing an installed pack takes its presets out of favourites in the engine (deleteInstalledPresetArchive).",
    "setPresetRatings": "Kept for older UIs and scripted use (a whole ratings document); every UI now rates presets one at a time (setPresetRating), and removing an installed pack drops its presets' ratings in the engine (deleteInstalledPresetArchive).",
    "setSetlists": "Kept for older UIs and scripted use (a whole setlists document); every UI now edits setlists by name (createSetlist, setSetlistSlot, moveSetlistSlot, ...), which the engine answers with setlists and setlistCursorChanged.",
    "setUserInputCalibrationTrainingActive": "Kept for older UIs and scripted use; every UI now trains with startInputLevellingTraining and stopInputLevellingTraining, which it is the same as (PresetManagementWorkflowTests and UiClientTests drive it).",
    "splitSignalPathEdge": "The engine can split an edge into parallel lanes; the UI has no gesture for it yet, though it can show and collapse an existing split."
  },
  "sentButUnhandled": {
    "debugSnapshot": "Not a message: the type tag inside the debug snapshot file written to disk. The UI is told with debugSnapshotWritten.",
    "toneSharingPackDeleted": "Confirms deleteImportedToneSharingPack; the UI removes the pack from its list before asking, so there is nothing to update."
  },
