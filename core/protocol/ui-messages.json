  "engineOnlyRequests": {
    "getPerformanceStats": "A pull for tests and scripted debugging (MixerInstanceLockTests drives the telemetry read with it); the UI takes the pushed dspPerformance feed.",
    "getSignalDiagnostics": "A pull for tests and scripted debugging; the UI takes the pushed sld feed and asks for a roster with setSignalDiagnosticsEnabled.",
    "setMasterGain": "Kept for older UIs and scripted use; the UI mutes with setOutputMuted, which the mixer applies after the output gain so a chain rebuild cannot undo it, and sets levels with setGlobalChainParam output.gain.",
    "splitSignalPathEdge": "The engine can split an edge into parallel lanes; the UI has no gesture for it yet, though it can show and collapse an existing split."
  },
  "sentButUnhandled": {
    "debugSnapshot": "Not a message: the type tag inside the debug snapshot file written to disk. The UI is told with debugSnapshotWritten.",
    "riffCaptureArmed": "Confirms armRiffCapture; the UI enters the armed state itself when it sends the request.",
    "toneSharingPackDeleted": "Confirms deleteImportedToneSharingPack; the UI removes the pack from its list before asking, so there is nothing to update."
  },
