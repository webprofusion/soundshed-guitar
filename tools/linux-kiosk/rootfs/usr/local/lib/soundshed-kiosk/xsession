#!/bin/sh
# The X client for the xorg session: keep the screen on, then become the app.
# With no window manager, --kiosk sizes the window to the display itself.
xset s off s noblank -dpms 2>/dev/null || true

# A display that offers more than this would have every pixel drawn for it. A screen without
# the mode keeps its own.
if [ -n "${SOUNDSHED_DISPLAY_MODE:-}" ]; then
    output="$(xrandr --query | awk '$2 == "connected" { print $1; exit }')"
    if [ -n "$output" ]; then
        xrandr --output "$output" --mode "$SOUNDSHED_DISPLAY_MODE" 2>/dev/null || true
    fi
fi

exec "$@"
